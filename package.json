{
  "name": "samesight-workspace",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo build",
    "build:packages": "turbo build --filter=./packages/*",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test --concurrency=1",
    "smoke": "node scripts/pack-smoke.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.19.0",
    "supabase": "^2.122.0",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitepress": "1.6.4",
    "vitest": "^5.0.5"
  }
}
