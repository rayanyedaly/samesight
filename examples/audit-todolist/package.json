{
  "name": "audit-todolist",
  "version": "0.0.0",
  "private": true,
  "description": "Runs samesight-verify audit on PowerSync's Supabase to-do list demo, fetched at a pinned commit",
  "type": "module",
  "scripts": {
    "fetch": "bash scripts/fetch.sh",
    "stack:up": "bash scripts/stack-up.sh",
    "stack:down": "bash scripts/stack-down.sh",
    "verify": "samesight-verify audit --project upstream --sync-config upstream/sync-config.yaml",
    "verify:planted": "bash scripts/verify-planted.sh",
    "verify:rules": "bash scripts/verify-rules.sh"
  },
  "devDependencies": {
    "@samesight/verify": "workspace:*"
  }
}
