{
  "name": "@samesight/supabase",
  "version": "0.1.0",
  "description": "PowerSync connector for Supabase that does not lose writes: one atomic apply_batch call per transaction, and refused writes kept",
  "license": "MIT",
  "author": "Rayan Yedaly",
  "homepage": "https://github.com/rayanyedaly/samesight/tree/main/packages/supabase#readme",
  "bugs": "https://github.com/rayanyedaly/samesight/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayanyedaly/samesight.git",
    "directory": "packages/supabase"
  },
  "keywords": [
    "supabase",
    "powersync",
    "rls",
    "row-level-security",
    "sync",
    "offline-first",
    "local-first",
    "postgres",
    "connector",
    "upload-queue",
    "dead-letter-queue"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@powersync/common": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0"
  },
  "devDependencies": {
    "@powersync/common": "^2.4.0",
    "@supabase/supabase-js": "^2.118.0"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "sideEffects": false
}
